{
  "name": "ELK Lead Agent",
  "install": "bash scripts/setup.sh",
  "terminals": [
    {
      "name": "lead-agent-scheduler",
      "command": ".venv/bin/elk-agent schedule --at 06:00 --email"
    },
    {
      "name": "report-server",
      "command": ".venv/bin/elk-agent serve --port 8000"
    }
  ],
  "ports": [8000]
}
